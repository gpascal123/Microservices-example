# Copy this file to .env and fill in the values before starting the stack.
# .env is listed in .gitignore and will never be committed.
# Run ./start.sh to generate all keys and credentials automatically.

# JWT key pair – generated by: go run ./tools/keygen
JWT_PRIVATE_KEY="<generate with: go run ./tools/keygen>"
JWT_PUBLIC_KEY="<generate with: go run ./tools/keygen>"

# Service-to-service key pair – generated by: go run ./tools/keygen service
SERVICE_PRIVATE_KEY="<generate with: go run ./tools/keygen service>"
SERVICE_PUBLIC_KEY="<generate with: go run ./tools/keygen service>"

# PostgreSQL credentials – generated automatically by ./start.sh
# Use a strong, randomly generated password in all environments.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="<generate a strong random password>"
